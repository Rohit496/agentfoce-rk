<?xml version="1.0" encoding="UTF-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <classAccesses>
        <apexClass>WeatherService</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <description>Lets users call OpenWeatherMap through the OpenWeatherMap named credential (API key stored in the External Credential, sent as the x-api-key header).</description>
    <externalCredentialPrincipalAccesses>
        <enabled>true</enabled>
        <externalCredentialPrincipal>OpenWeatherMap-OpenWeatherMapPrincipal</externalCredentialPrincipal>
    </externalCredentialPrincipalAccesses>
    <hasActivationRequired>false</hasActivationRequired>
    <label>OpenWeatherMap Access</label>
</PermissionSet>
